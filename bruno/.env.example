# Bruno secrets — copy to `bruno/.env` and fill in. NEVER commit the real file.
#
# `bruno/.env` is covered by .gitignore (`bruno/**/.env`). The environment
# files under bruno/environments/ reference these by name via
# {{process.env.NAME}}, so a real secret never lands in a tracked file even
# by accident.

# Admin API token — the X-Admin-Token header on privileged API routes.
# Value lives in Azure App Configuration under CommonConfig:Api:AdminToken.
SD_ADMIN_TOKEN=

# Google Maps API key, for the venue/map requests.
SD_GOOGLE_API_KEY=
